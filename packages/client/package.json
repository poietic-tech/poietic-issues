{
  "name": "@poietic-tech/issues-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client generated from the OpenAPI document.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "gen": "openapi-typescript ../../docs/openapi.json -o src/generated/openapi.d.ts --root-types --root-types-no-schema-prefix --default-non-nullable false"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@poietic-tech/issues-schema": "workspace:*",
    "openapi-typescript": "^7.13.0"
  }
}
