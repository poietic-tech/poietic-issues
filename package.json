{
  "name": "poietic-issues",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "TEST_DB=postgres vitest run",
    "pg": "bash scripts/pg.sh",
    "openapi:gen": "pnpm --filter @poietic-tech/issues-server openapi:gen && pnpm --filter @poietic-tech/issues-client gen",
    "openapi:check": "pnpm --filter @poietic-tech/issues-server openapi:check && pnpm --filter @poietic-tech/issues-client gen && git diff --exit-code -- packages/client/src/generated",
    "dev:server": "pnpm --filter @poietic-tech/issues-server dev",
    "issues-admin": "node apps/cli/src/admin-bin.ts",
    "dev": "node scripts/dev.ts",
    "build:web": "pnpm --filter @poietic-tech/issues-web build",
    "build": "pnpm build:web && tsdown",
    "start": "node dist/server.mjs",
    "e2e": "pnpm build:web && pnpm --filter @poietic-tech/issues-web e2e",
    "build:demo": "pnpm --filter @poietic-tech/issues-web build:demo",
    "e2e:demo": "pnpm build:demo && pnpm --filter @poietic-tech/issues-web e2e:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
