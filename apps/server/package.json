{
  "name": "@poietic-tech/issues-server",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API server (Hono) exposing @poietic-tech/issues-core over /api/v1.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "dev": "node --watch --watch-path=src --watch-path=../../packages src/main.ts",
    "start": "node src/main.ts",
    "openapi:gen": "node src/scripts/gen-openapi.ts",
    "openapi:check": "node src/scripts/gen-openapi.ts --check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@poietic-tech/auth": "^0.2.1",
    "@poietic-tech/issues-core": "workspace:*",
    "@poietic-tech/issues-db": "workspace:*",
    "@poietic-tech/issues-schema": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.6",
    "hono": "^4.13.9",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@poietic-tech/issues-client": "workspace:*",
    "vitest": "^5.0.2"
  }
}
