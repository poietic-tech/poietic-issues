{
  "name": "@poietic-tech/issues",
  "version": "0.1.0",
  "description": "The poietic-tech issues module: the issue tracker at issues.poietic.tech, from the poietic-tech command line.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/poietic-tech.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poietic-tech/poietic-issues.git",
    "directory": "apps/cli"
  },
  "poietic-tech": {
    "command": "issues",
    "entry": "./dist/poietic-tech.js",
    "api": 1,
    "summary": "Issue tracker at issues.poietic.tech"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build:module": "tsdown"
  },
  "peerDependencies": {
    "@poietic-tech/cli": "^0.1.1"
  },
  "devDependencies": {
    "@poietic-tech/cli": "^0.1.1",
    "@poietic-tech/issues-client": "workspace:*",
    "@poietic-tech/issues-core": "workspace:*",
    "@poietic-tech/issues-db": "workspace:*",
    "@poietic-tech/issues-schema": "workspace:*",
    "@poietic-tech/issues-server": "workspace:*",
    "commander": "^14.0.3",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.5"
  }
}
